pipeline {
    agent any
    stages {
        stage('Manual Git Clone') {
            steps {
                sh '''
                rm -rf wakeupmate
                git clone -b jenkinsfile-test https://github.com/gitFILO/wakeupmate.git
                cd wakeupmate/backend/wakeupmate
                ls -al
                '''
            }
        }
        stage('Test') {
            steps {
                echo "✅ Jenkinsfile executed after manual git clone!"
            }
        }
    }
}