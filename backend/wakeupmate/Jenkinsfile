pipeline {
    agent any

    stages {
        stage('Create .env') {
            steps {
                sh '''
                echo "MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD" > .env
                echo "MYSQL_DATABASE=$MYSQL_DATABASE" >> .env
                echo "MYSQL_USER=$MYSQL_USER" >> .env
                echo "MYSQL_PASSWORD=$MYSQL_PASSWORD" >> .env
                '''
            }
        }

        stage('Build & Deploy') {
            steps {
                script {
                    sh """
                    docker compose -f ./backend/wakeupmate/compose.yaml down
                    docker compose -f ./backend/wakeupmate/compose.yaml up -d --build
                    """

                    sh """
                    mkdir -p backend/wakeupmate/src/main/resources
                    cp /var/jenkins_home/secure-configs/application.yml backend/wakeupmate/src/main/resources/application.yml
                    """

                    sh """
                    cd backend/wakeupmate
                    ./gradlew build

                    PID=\$(lsof -ti :8080 || true)
                    if [ ! -z "\$PID" ]; then
                        kill -9 \$PID
                    fi

                    nohup java -jar build/libs/*.jar > spring.log 2>&1 &
                    """
                }
            }
        }
    }
}