pipeline {
    agent any

    stages {
        stage('Create .env') {
            steps {
                sh '''
                echo "MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD" > .env
                echo "MYSQL_DATABASE=$MYSQL_DATABASE" >> .env
                echo "MYSQL_USER=$MYSQL_USER" >> .env
                echo "MYSQL_PASSWORD=$MYSQL_PASSWORD" >> .env
                '''
            }
        }

        stage('Build & Deploy') {
            steps {
                script {
                    sh """
                    docker-compose -f ./backend/wakeupmate/compose.yml down
                    docker-compose -f ./backend/wakeupmate/compose.yml up -d --build
                    """
                }
            }
        }
    }
}