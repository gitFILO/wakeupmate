pipeline {
    agent any

    environment {
        MYSQL_ROOT_PASSWORD = credentials('mysql_root_password')
        MYSQL_DATABASE = 'mydb'
        MYSQL_USER = 'me'
        MYSQL_PASSWORD = credentials('mysql_password')
    }

    stages {
        stage('Create .env') {
            steps {
                sh '''
                echo "MYSQL_ROOT_PASSWORD=$MYSQL_ROOT_PASSWORD" > backend/wakeupmate/.env
                echo "MYSQL_DATABASE=$MYSQL_DATABASE" >> backend/wakeupmate/.env
                echo "MYSQL_USER=$MYSQL_USER" >> backend/wakeupmate/.env
                echo "MYSQL_PASSWORD=$MYSQL_PASSWORD" >> backend/wakeupmate/.env
                '''
            }
        }

        stage('Build & Deploy') {
            steps {
                sh '''
                docker-compose -f backend/wakeupmate/docker-compose.yml down
                docker-compose -f backend/wakeupmate/docker-compose.yml up -d --build
                '''
            }
        }
    }
}